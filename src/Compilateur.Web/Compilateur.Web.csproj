<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BlazorMonaco" Version="3.5.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Compilateur.Core\Compilateur.Core.csproj"/>
    </ItemGroup>

    <!-- Import compliance tests -->
    <ItemGroup>
        <EmbeddedResource Include="..\Compilateur.Tests\Conformance\Lox\**\*.lox"
                          LogicalName="%(RecursiveDir)%(Filename)%(Extension)"
                          Link="Lox\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
